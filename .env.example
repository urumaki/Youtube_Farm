# Copy to .env and fill in locally. Never commit .env (it is in .gitignore).
# In GitHub Actions set these as repository secrets instead.

# --- subscriber count -------------------------------------------------------
# public (default): YouTube Data API v3 key, count rounded to 3 significant figures above 1,000
YOUTUBE_API_KEY=
YOUTUBE_HANDLE=@Subscriber_Kingdom
# COUNT_MODE=exact uses the YouTube Analytics API for your own channel (OAuth refresh token)
COUNT_MODE=public
YT_OAUTH_CLIENT_ID=
YT_OAUTH_CLIENT_SECRET=
YT_OAUTH_REFRESH_TOKEN=
EXACT_COUNT_OFFSET=0

# --- narration --------------------------------------------------------------
# TTS_PROVIDER=kokoro (default, free, local), piper (lighter fallback) or elevenlabs (cloud)
TTS_PROVIDER=kokoro
# Kokoro voices: bm_george (British male, default), bm_fable, am_michael, am_adam, af_heart ... ; Italian im_nicola, if_sara
KOKORO_VOICE_EN=bm_george
KOKORO_VOICE_IT=im_nicola
KOKORO_SPEED=1.05
PYTHON=
PIPER_BIN=
PIPER_VOICE_EN=
PIPER_SPEAKER_EN=20
PIPER_VOICE_IT=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- optional ---------------------------------------------------------------
CHROMIUM_PATH=
