# Copia in .env (mai committare .env). Valori reali solo in locale.
BLENDER=
# YouTube Data API v3 (OAuth desktop app)
YOUTUBE_CLIENT_SECRETS=credentials/client_secret.json
YOUTUBE_TOKEN_FILE=credentials/youtube_token.json
# Instagram Graph API (account Business/Creator)
IG_USER_ID=
IG_ACCESS_TOKEN=
# Instagram richiede URL pubblico del video
IG_VIDEO_PUBLIC_URL_BASE=
# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=
