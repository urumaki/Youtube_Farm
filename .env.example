# Copy to .env and fill in locally. Never commit .env (it is in .gitignore).
# In GitHub Actions set these as repository secrets instead.

# --- subscriber count -------------------------------------------------------
# public (default): YouTube Data API v3 key, count rounded to 3 significant figures above 1,000
YOUTUBE_API_KEY=
YOUTUBE_HANDLE=@Subscriber_Kingdom
# COUNT_MODE=exact uses the YouTube Analytics API for your own channel (OAuth refresh token)
COUNT_MODE=public
# OAuth client (Desktop app) + refresh token from `npm run auth:youtube` — used for uploads and exact mode
YT_OAUTH_CLIENT_ID=
YT_OAUTH_CLIENT_SECRET=
YT_OAUTH_REFRESH_TOKEN=
EXACT_COUNT_OFFSET=0

# --- narration --------------------------------------------------------------
# TTS_PROVIDER=kokoro (default, free, local), piper (lighter fallback) or elevenlabs (cloud)
TTS_PROVIDER=kokoro
# Kokoro voices: am_adam (American male, default), bm_george, bm_fable, am_michael, af_heart ...
KOKORO_VOICE_EN=am_adam
KOKORO_SPEED=1.05
PYTHON=
PIPER_BIN=
PIPER_VOICE_EN=
PIPER_SPEAKER_EN=20
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- optional ---------------------------------------------------------------
CHROMIUM_PATH=

# --- publishing -------------------------------------------------------------
# PUBLISH_TARGETS=youtube uploads each daily video as a Short (empty = no upload)
PUBLISH_TARGETS=
# public | unlisted | private
YT_PRIVACY=public
# optional scheduled publishing time, HH:MM in UTC (uploads as private and goes public then)
YT_PUBLISH_AT=
